{
  "name": "collaborative-drawing-canvas",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
